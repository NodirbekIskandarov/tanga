# --- Majburiy ---
TELEGRAM_TOKEN=bu_yerga_botfather_bergan_token
# Google AI Studio / Cloud kaliti. FAQAT billing yoqilgan (pullik) loyiha:
# bepul daraja kontentni Google mahsulotlarini yaxshilashga ishlatadi.
GEMINI_API_KEY=bu_yerga_gemini_kaliti

# Bot egalari — obunasiz, limitsiz foydalanadi va admin buyruqlariga ega.
# Botga /id yozib olingan raqamni shu yerga qo'ying.
OWNER_IDS=123456789

# YOPIQ rejim: faqat shu ID'lar kiradi (sinov guruhi uchun).
# BO'SH qoldirilsa — bot HAMMAGA ochiq, har kim bepul sinov oladi.
ALLOWED_USER_IDS=

# --- Obuna ---
# Yangi foydalanuvchi uchun bepul sinov muddati (kun)
TRIAL_DAYS=7
# Obuna bo'lish uchun murojaat manzili (foydalanuvchiga ko'rsatiladi)
SUPPORT_CONTACT=@Nodirbek_8545

# --- Kunlik limitlar (suiiste'moldan himoya; egalarga qo'llanmaydi) ---
LIMIT_TEXT_PER_DAY=120
LIMIT_RECEIPT_PER_DAY=10
# Sinov (7 kunlik PRO) davomida jami chek soni
TRIAL_RECEIPTS_TOTAL=10
LIMIT_QA_PER_DAY=30

# Bir vaqtda qayta ishlanadigan yangilanishlar (ko'p foydalanuvchi uchun)
MAX_CONCURRENT_UPDATES=64

# --- To'lov (karta o'tkazmasi) ---
# Foydalanuvchi shu kartaga pul o'tkazadi va chek skrinshotini yuboradi,
# admin panelda tasdiqlanadi. Click/Payme keyinroq qo'shiladi.
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=ISKANDAROV NODIRBEK
CARD_BANK=Kapitalbank

# Admin web paneli manzili — egaga bildirishnomada ko'rsatiladi
ADMIN_PANEL_URL=https://tanga.niskandarov.uz

# Do'st taklif qilgani uchun ikkala tomonga qo'shiladigan bepul kunlar
REFERRAL_BONUS_DAYS=7

# Xizmat ko'rsatuvchi rekvizitlari — ommaviy ofertada (/shartlar)
# ko'rsatiladi. Ro'yxatdan o'tgandan keyin to'ldiring; bo'sh bo'lsa
# ofertada bu qator umuman chiqmaydi.
OPERATOR_NAME=
OPERATOR_STATUS=
OPERATOR_TAX_ID=

# Necha kun yozmagan odamga «qaytish» eslatmasi yuboriladi.
# Bitta odamga oyiga bir martadan ko'p yuborilmaydi.
WINBACK_DAYS=7

# Oylik AI sarfi chegarasi ($). Yetganda bot to'xtaydi va egaga
# xabar beradi. 80% da oldindan ogohlantiradi. 0 — chegarasiz.
MONTHLY_BUDGET_USD=50
# Kishi boshiga oylik AI chegarasi ($) — faqat bepul va sinov uchun.
# Obunachilar bu chegaraga ham, umumiy chegaraga ham urilmaydi. 0 — o'chiq.
USER_MONTHLY_BUDGET_USD=0.5

# --- Ixtiyoriy ---
PARSE_MODEL=gemini-3.5-flash-lite
# Ovozli xabar (transkripsiya + ajratish bitta chaqiruvda). Aniqlik pasaysa:
# VOICE_MODEL=gemini-3.8-flash
VOICE_MODEL=gemini-3.5-flash-lite
CHAT_MODEL=gemini-3.8-flash
# Chek rasmini o'qiydigan model
VISION_MODEL=gemini-3.8-flash
# «O'ylash» darajasi: minimal | low | medium | high (o'ylash tokenlari
# chiqish narxida). Matn va ovozda minimal, chek va savolda medium.
PARSE_THINKING=minimal
VOICE_THINKING=minimal
VISION_THINKING=medium
CHAT_THINKING=medium

# --- Ovozli kiritish ---
# Avval o'chiq (false). Keyin beta: VOICE_ENABLED=true va
# VOICE_BETA_USER_IDS=111,222 (faqat shular va egalar). Hammaga ochish:
# VOICE_BETA_USER_IDS bo'sh.
VOICE_ENABLED=false
VOICE_BETA_USER_IDS=
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=2000000
# Shundan katta summa ovozdan aniqlansa — tasdiq so'raladi
VOICE_CONFIRM_ABOVE_SOM=5000000
VOICE_CONFIRM_ABOVE_USD=500
# Kunlik limit: PRO / Bepul (biznes qarori)
LIMIT_VOICE_PER_DAY=40
FREE_VOICE_PER_DAY=5
DB_PATH=tanga.db
CURRENCY=so'm
TIMEZONE=Asia/Tashkent

# "obedga 50" -> 50 000 so'm deb tushunilsinmi?
SMALL_NUMBERS_ARE_THOUSANDS=true

# Savolga javob berishda AI ko'radigan maksimal XOM yozuvlar soni.
# Jamlanmalar baribir Python'da hisoblanadi, shuning uchun 150 yetarli.
# 500 da bitta savol ~$0.14, 150 da ~$0.05 turadi.
QA_MAX_ROWS=150

# Bitta chek uchun maksimal rasm soni (uzun chekni bo'lib yuborish uchun)
MAX_RECEIPT_PARTS=8
# Bitta rasm uchun maksimal hajm (bayt)
MAX_IMAGE_BYTES=4500000

# Bazani shifrlash kaliti — 64 ta o'n oltilik belgi (32 bayt).
# Bo'sh bo'lsa baza oddiy SQLite sifatida ochiladi (mahalliy ishlab chiqish).
# Yangi kalit: python -c "import secrets; print(secrets.token_hex(32))"
#
# DIQQAT: kalit yo'qolsa baza VA zaxira nusxalar butunlay ochilmay qoladi.
# Uni serverdan tashqarida ham saqlang (parol menejeri).
DB_ENCRYPTION_KEY=

# Foydalanuvchilarning MOLIYAVIY yozuvlari alohida faylda, alohida kalit
# bilan saqlanadi. Sababi: asosiy bazani admin panel ham ochadi, chunki
# unga obuna va to'lov kerak. Yozuvlar o'sha faylda bo'lsa panel ularni
# o'qiy olardi va himoya faqat "kod so'ramaydi" degan va'daga tayanardi.
#
# Shuning uchun bu kalit FAQAT shu yerda (botda) turadi va tanga-admin
# ning .env iga QO'YILMAYDI. Ikkalasi bir xil bo'lsa ajratishning ma'nosi
# qolmaydi.
#
# DIQQAT: bu kalit yo'qolsa odamlarning butun moliyaviy tarixi
# qaytarilmaydi. Uni serverdan tashqarida ham saqlang.
PRIVATE_DB_KEY=
PRIVATE_DB_PATH=tanga_shaxsiy.db
